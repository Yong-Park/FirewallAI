{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(netsh *)",
      "Bash(*New-NetFirewall*)",
      "Bash(*Set-NetFirewall*)",
      "Bash(*Remove-NetFirewall*)",
      "Bash(*Enable-NetFirewall*)",
      "Bash(*Disable-NetFirewall*)",
      "Bash(*Rename-NetFirewall*)",
      "Bash(*Copy-NetFirewall*)",
      "PowerShell(netsh *)",
      "PowerShell(New-NetFirewall*)",
      "PowerShell(Set-NetFirewall*)",
      "PowerShell(Remove-NetFirewall*)",
      "PowerShell(Enable-NetFirewall*)",
      "PowerShell(Disable-NetFirewall*)",
      "PowerShell(Rename-NetFirewall*)",
      "PowerShell(Copy-NetFirewall*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *+*)",
      "Bash(git reset *--hard*)",
      "Bash(git branch *-D*)",
      "Bash(git branch *-d*)",
      "Bash(git branch *--delete*)",
      "Bash(git push *--delete*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git branch *-d*)",
      "PowerShell(git branch *--delete*)",
      "PowerShell(git push *--delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
